# ==============================================================================
# AQUAWAY TOURS — HOSTINGER LITESPEED / APACHE PRODUCTION CONFIGURATION
# High-Rocket SEO, Security, Fast Caching & Core Web Vitals Optimization (2026)
# ==============================================================================

# ─── 1. DEFAULT CHARSET ───────────────────────────────────────────────────────
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .json .xml .svg

# ─── 2. REWRITE ENGINE: HTTPS & CANONICAL DOMAIN ──────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Block access to hidden files and sensitive directories
    RewriteRule "(^|/)\.(?!well-known)" - [F]

    # Custom 404 fallback for missing files
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^([a-z]{2})/trips/(.+)\.html$ /trips/$2.html [L]
</IfModule>

# ─── 3. CUSTOM ERROR PAGES ────────────────────────────────────────────────────
ErrorDocument 404 /404.html

# ─── 4. GZIP / DEFLATE / BROTLI COMPRESSION ──────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/atom_xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ─── 5. BROWSER CACHING (EXPIRES & CACHE-CONTROL) ─────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML Documents: 1 hour (ensures quick update propagation)
    ExpiresByType text/html "access plus 1 hour"

    # Data / Manifests / Feeds
    ExpiresByType application/json "access plus 1 day"
    ExpiresByType application/manifest+json "access plus 1 week"
    ExpiresByType text/xml "access plus 1 hour"
    ExpiresByType application/xml "access plus 1 hour"

    # Stylesheets and Scripts: 1 month
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"

    # Images & Media: 1 year (Immutable asset caching for 100/100 Core Web Vitals)
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType audio/mpeg "access plus 1 year"
    ExpiresByType audio/mp3 "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"

    # Web Fonts: 1 year
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
</IfModule>

# ─── 6. HTTP HEADERS: SECURITY, SEO & CORS ────────────────────────────────────
<IfModule mod_headers.c>
    # Security Headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"

    # Allow Fonts and Icons from CDN / Cross-Origin
    <FilesMatch "\.(ttf|ttc|otf|eot|woff|woff2|font.css|css|js|webp|png|jpg|mp3)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>

    # Static Assets Cache-Control Headers
    <FilesMatch "\.(ico|jpe?g|png|gif|webp|avif|mp3|mp4|woff2?|ttf|svg)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>

    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>

    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "max-age=3600, must-revalidate"
    </FilesMatch>

    # Vary header for proper caching behind CDNs
    Header append Vary "Accept-Encoding"
</IfModule>

# ─── 7. MIME TYPES ────────────────────────────────────────────────────────────
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/avif .avif
    AddType audio/mpeg .mp3
    AddType video/mp4 .mp4
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType application/manifest+json .webmanifest
</IfModule>
